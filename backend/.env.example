# Copiar este archivo como .env y reemplazar los valores de ejemplo.

# --- Base de datos (obligatoria, sin valor por defecto en el código) ---
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
# Si se usa el compose.yaml incluido, USUARIO/CONTRASENA/BASE deben coincidir con las variables POSTGRES_* de abajo.
DATABASE_URL=postgresql://foodstore:cambiar-esta-clave-local@localhost:5432/foodstore_db

# --- JWT (SECRET_KEY obligatoria, mínimo 32 caracteres) ---
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS: origen del frontend (Vite) ---
FRONTEND_ORIGIN=http://localhost:5173

# Cookie con atributo Secure (true solo si se sirve por HTTPS)
COOKIE_SECURE=false

# --- Solo para el contenedor de compose.yaml (opcional si se usa un PostgreSQL local) ---
POSTGRES_USER=foodstore
POSTGRES_PASSWORD=cambiar-esta-clave-local
POSTGRES_DB=foodstore_db
POSTGRES_PORT=5432
